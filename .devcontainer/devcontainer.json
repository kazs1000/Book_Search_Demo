{
  "name": "book-search",
  "build": {
    "dockerfile": "../../.devcontainer-image/Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
    "ghcr.io/devcontainers/features/aws-cli:1": {},
    "ghcr.io/devcontainers/features/terraform:1": {
      "version": "1.15.5"
    }
  },
"postCreateCommand": "npm install -g @anthropic-ai/claude-code @google/gemini-cli @openai/codex",
  "workspaceFolder": "/workspace",
  "mounts": [
    "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
    "source=/Users/kazuki/Library/Mobile Documents/iCloud~md~obsidian/Documents/MyMemo/Projects/book-search,target=/knowledge,type=bind,consistency=cached",
    "source=${localWorkspaceFolder}/../.claude,target=/home/vscode/.claude,type=bind,consistency=cached",
    "source=${localWorkspaceFolder}/../.claude.json,target=/home/vscode/.claude.json,type=bind,consistency=cached",
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind",
    "source=${localEnv:HOME}/.aws,target=/home/vscode/.aws,type=bind",
    "source=${localWorkspaceFolder}/../.gemini,target=/home/vscode/.gemini,type=bind,consistency=cached",
    "source=${localWorkspaceFolder}/../.codex,target=/home/vscode/.codex,type=bind,consistency=cached"
  ],
  "remoteUser": "vscode"
}